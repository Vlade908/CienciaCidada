# =============================================================================
# ECOCIDADÃO (EXEMPLO) — COPIE PARA .env.local E PREENCHA SUAS CHAVES
# =============================================================================

# Variáveis Públicas (Expostas no Client-Side / Navegador do Cidadão)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Variável Estritamente Privada (Server-Side / Nunca exposta no browser)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-service-role-aqui
