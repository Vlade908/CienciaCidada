# =============================================================================
# ECOCIDADÃO — .gitignore (Segurança e Artefatos de Build)
# =============================================================================

# Dependências
/node_modules
/.pnp
.pnp.js
.yarn/cache

# Build e Produção do Next.js
/.next/
/out/
/build
dist

# Variáveis de Ambiente e Segredos (CRÍTICO - NUNCA ENVIAR PARA O GITHUB)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Diagnósticos e TypeScript
next-env.d.ts
*.tsbuildinfo

# IDEs e Sistema Operacional
.DS_Store
*.pem
.vscode/
.idea/
*.swp
*.swo
